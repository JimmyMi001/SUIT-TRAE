# =============================================================
# 123 就出发 — 环境变量配置
# =============================================================
# 第一次启动会自动从 .env.example 复制生成此文件
# 填入你自己的密钥后保存即可,不需要重启电脑
# =============================================================

# 服务端口(默认 3000,一般不用改)
PORT=3000

# =============================================================
# 必填项:两个 API 密钥
# =============================================================

# 1) 高德地图 Web 服务 API Key
#    申请: https://lbs.amap.com/dev/key/app
#    步骤: 注册 → 控制台 → 应用管理 → 创建新应用
#          → 添加 Key → 服务平台选 "Web 服务" → 提交
#    免费额度: 每日 5000 次调用,够个人使用
AMAP_KEY=your_amap_key_here

# 2) DeepSeek API Key (用于 AI 行程设计 + 旅途伴侣对话)
#    申请: https://platform.deepseek.com/api_keys
#    步骤: 注册 → API Keys → 创建新 Key → 复制
#    免费额度: 注册送 ¥10 余额,deepseek-chat ¥1/百万tokens
DEEPSEEK_KEY=your_deepseek_key_here

# =============================================================
# 可选项:不填也能跑
# =============================================================

# 携程机票真实价格爬虫(需要先 npm i puppeteer,体积较大)
# 设为 1 启用,0 或不设走参考价
ENABLE_FLIGHT_CRAWLER=0

# 飞猪 FlyAI 真实机票/酒店/POI (可选)
# 已内置官方体验匿名 Key,开箱即用;机票价格完整真实,酒店价格脱敏(¥2xx/¥3xx)
# 填写正式 Key 后解锁酒店完整价格
# 文档: https://flyai.open.fliggy.com/docs/quickstart
# FLYAI_API_KEY=your_flyai_api_key_here
# FLYAI_SIGN_SECRET=your_flyai_sign_secret_here

# 途牛开放平台真实门票 (可选)
# 免费注册: https://open.tuniu.com/ (RPM 5次/分, RPD 50次/天, 服务端6小时缓存)
# 未配置时 /api/tuniu/* 返回引导提示,不阻塞其他功能
# TUNIU_API_KEY=your_tuniu_api_key_here

# 美团酒旅直连 (可选 · 官方 openapi, 真实酒店/机票/门票)
# Token 申请: https://developer.meituan.com/zh/v2/dev/token (API Token)
# 官方 skill 安装(可选,仅用于查看文档): npm i -g mtskills-cli && mtskills i meituan-travel
# 已内置直连协议: POST https://mcp-open-cater.meituan.com/v1/api/voyage/openapi/query
# 响应为 AI 生成式回答(约15~60s, 6小时缓存), 真实条目附 dpurl.cn 预订短链
# 兼容旧变量: 未设置 MEITUAN_HT_TOKEN 时自动回退使用 MEITUAN_API_KEY
# 未配置时自动降级为飞猪/途牛/高德/本地数据,不阻塞其他功能
# MEITUAN_HT_TOKEN=your_meituan_token_here   # 从 https://developer.meituan.com/zh/v2/dev/token 申请
# MEITUAN_API_KEY=your_meituan_token_here   (旧变量名,兼容回退)

# 多源联合决策 /api/consensus (自动启用)
# 对同一需求(机票/酒店/门票)并发拉取美团酒旅 + 飞猪 FlyAI + 途牛 + 12306 + 高德 的真实数据,
# 每条价格标注来源并附带购票/预订跳转链接,再由 DeepSeek 给出 ≤130 字联合决策建议。
# 无需额外配置,依赖上述各数据源的 Key 是否就绪。

# 自动把 AI 生成的路线存到社区路线库
# 设为 1 启用,0 或不设需手动入库
AUTO_SAVE_ROUTES=0

# 运行环境(development / production)
# NODE_ENV=development
