# =============================================================
# 123 就出发 — 环境变量模板
# =============================================================
# 使用方法:
#   1) cp .env.example .env
#   2) 在 .env 中填入你的真实密钥
#   3) .env 已在 .gitignore 中,不会推送到 GitHub
# =============================================================

# 服务端口（默认 3000）
PORT=3000

# 高德地图 Web 服务 API Key
# 申请地址: https://lbs.amap.com/dev/key/app
AMAP_KEY=your_amap_key_here

# DeepSeek API Key (AI 行程设计 + 旅途伴侣对话)
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_KEY=your_deepseek_key_here

# ---- 可选 ----

# 携程机票真实价格爬虫 (学习自 Suysker/Ctrip-Crawler)
# 设为 1 启用(需先安装 puppeteer: npm i puppeteer)
# 不设或设为 0 时,/api/flight 返回参考价
# ENABLE_FLIGHT_CRAWLER=0

# 自动入库生成的社区路线(默认关闭,避免数据污染)
# 设为 1 启用自动入库
# AUTO_SAVE_ROUTES=0

# 日志级别
# NODE_ENV=development
